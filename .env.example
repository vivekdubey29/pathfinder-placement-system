# PathFinder frontend environment configuration.
#
# Copy this file to .env and restart `npm.cmd run dev` after any change.
# .env is gitignored and will not be committed.
#
# VITE_USE_MOCK_API=true   → use built-in mock data + localStorage (no backend needed)
# VITE_USE_MOCK_API=false  → use the Spring Boot backend at VITE_API_BASE_URL
#
# Default is mock mode so the frontend works without starting the backend.
VITE_USE_MOCK_API=true

# Base URL of the Spring Boot backend (used only when VITE_USE_MOCK_API=false).
# The backend runs on port 8080 by default (see backend/src/main/resources/application.properties).
VITE_API_BASE_URL=http://localhost:8080
